[gd_scene load_steps=2 format=3 uid="uid://lumber-camp-ui"]

[ext_resource type="Script" path="res://scripts/lumber_camp_ui.gd" id="1_ui"]

[node name="LumberCampUi" type="CanvasLayer"]
script = ExtResource("1_ui")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -180.0
offset_top = -200.0
offset_right = 180.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 0

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Lumber Camp"
horizontal_alignment = 1

[node name="WorkersLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Workers: 0 / 6"
horizontal_alignment = 1

[node name="PoolLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Available in pool: 12"
horizontal_alignment = 1

[node name="WorkerControls" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 12

[node name="RemoveButton" type="Button" parent="Panel/Margin/VBox/WorkerControls"]
layout_mode = 2
custom_minimum_size = Vector2(48, 0)
text = "−"

[node name="AddButton" type="Button" parent="Panel/Margin/VBox/WorkerControls"]
layout_mode = 2
custom_minimum_size = Vector2(48, 0)
text = "+"

[node name="CloseButton" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Close"

[connection signal="pressed" from="Panel/Margin/VBox/WorkerControls/AddButton" to="." method="_on_add_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/WorkerControls/RemoveButton" to="." method="_on_remove_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/CloseButton" to="." method="_on_close_pressed"]
