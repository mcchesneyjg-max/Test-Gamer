[gd_scene load_steps=2 format=3 uid="uid://forester-ui"]

[ext_resource type="Script" path="res://scripts/forester_ui.gd" id="1_ui"]

[node name="ForesterUi" type="CanvasLayer"]
script = ExtResource("1_ui")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -180.0
offset_top = -190.0
offset_right = 180.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 0

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Forester Lodge"
horizontal_alignment = 1

[node name="ZoneLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "No planting zone"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Draw a zone to start planting."
autowrap_mode = 2
horizontal_alignment = 1

[node name="DrawZoneButton" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Draw Planting Zone"

[node name="CloseButton" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Close"

[node name="DrawHintLabel" type="Label" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -320.0
offset_top = 12.0
offset_right = 320.0
offset_bottom = 52.0
grow_horizontal = 2
theme_override_colors/font_color = Color(1, 0.95, 0.7, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 14
text = "Draw planting zone"
horizontal_alignment = 1
autowrap_mode = 2

[connection signal="pressed" from="Panel/Margin/VBox/DrawZoneButton" to="." method="_on_draw_zone_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/CloseButton" to="." method="_on_close_pressed"]
